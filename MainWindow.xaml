<Window x:Class="ChartSettingsProject.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sections="clr-namespace:ChartSettingsPanel.Sections"
        Title="Chart Settings"
        Width="1000"
        Height="700"
        MinWidth="800"
        MinHeight="500">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0">
            <StackPanel>
                <Button Content="Chart"/>
                <Button Content="Axes"/>
                <Button Content="Candles"/>
                <Button Content="Grid &amp; Background"/>
                <Button Content="Drawing Tools"/>
                <Button Content="Analytical Modules"/>
                <Button Content="HUD Overlay"/>
                <Button Content="Performance"/>
                <Button Content="Workspace"/>
                <Button Content="Advanced"/>
            </StackPanel>
        </Border>

        <ContentControl Grid.Column="1">
            <sections:ChartSettings/>
        </ContentControl>
    </Grid>
</Window>
