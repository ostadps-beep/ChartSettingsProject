<Window x:Class="ChartSettingsProject.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sections="clr-namespace:ChartSettingsPanel.Sections"
        Title="Chart Settings"
        Width="1000"
        Height="700"
        MinWidth="800"
        MinHeight="500">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TabControl Grid.Column="0">
            <TabItem Header="Chart">
                <Grid/>
            </TabItem>
            <TabItem Header="Axes"/>
            <TabItem Header="Candles"/>
            <TabItem Header="Grid &amp; Background"/>
            <TabItem Header="Drawing Tools"/>
            <TabItem Header="Analytical Modules"/>
            <TabItem Header="HUD Overlay"/>
            <TabItem Header="Performance"/>
            <TabItem Header="Workspace"/>
            <TabItem Header="Advanced"/>
        </TabControl>

        <ContentControl Grid.Column="1">
            <sections:ChartSettings/>
        </ContentControl>
    </Grid>
</Window>
