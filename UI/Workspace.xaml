<UserControl x:Class="ChartSettingsPanel.Sections.Workspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <GroupBox Header="Workspace" Style="{StaticResource DarkGroupBox}">
        <StackPanel>
            <CheckBox Content="Save Layout"
                      Style="{StaticResource DarkCheckBox}"
                      IsChecked="{Binding Settings.Workspace.SaveLayout}"/>
            <CheckBox Content="Load Layout"
                      Style="{StaticResource DarkCheckBox}"
                      IsChecked="{Binding Settings.Workspace.LoadLayout}"/>
            <CheckBox Content="Reset Layout"
                      Style="{StaticResource DarkCheckBox}"
                      IsChecked="{Binding Settings.Workspace.ResetLayout}"/>
        </StackPanel>
    </GroupBox>
</UserControl>
